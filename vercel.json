{
  "version": 2,
  "builds": [
    {
      "src": "compact-game/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/compact-game/index.html"
    },
    {
      "src": "/game",
      "dest": "/compact-game/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/compact-game/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
